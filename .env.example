# Optional settings. employMint needs none of these: leave them unset and it uses the defaults.
# To use one, set it in your shell before running a command, for example:
#   export CHROME_PATH="/path/to/Google Chrome"
# (employMint reads them from your environment; it does not load a .env file.)

# Where your profile files live. Default: the profile/ folder in this project.
# EMPLOYMINT_PROFILE_DIR=/path/to/profile

# Google Chrome, if it isn't installed in the usual place for your system.
# CHROME_PATH=/path/to/Google Chrome
